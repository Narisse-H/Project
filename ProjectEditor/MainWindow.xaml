<Window x:Class="ProjectEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProjectEditor"
        Width="1000"
        Height="650"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <!--
    Need to change:
        Window Size: 1000 * 650 (Minimum Size: 600 * 400)
        Start up location: CenterScreen
    -->

    <Grid x:Name="canvasRoot"
          ShowGridLines="False">
        <!--Grid Part (This name is a workaround for a bug.)-->

        <!--Row/Column Definition-->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!--Row 0-->
            <RowDefinition Height="*"/>
            <!--Row 1-->
            <RowDefinition Height="Auto"/>
            <!--Row 2-->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <!--Column 0-->
            <ColumnDefinition Width="Auto"/>
            <!--Column 1-->
            <ColumnDefinition Width="*"/>
            <!--Column 2-->
        </Grid.ColumnDefinitions>

        <!--Information Show & Button-->
        <Border Grid.Row="0"
                Grid.ColumnSpan="1"
                Background="#F3F3F3"
                Padding="8,6">
            <!--Padding: 8px left and right, 6px top and bottom-->

            <StackPanel Orientation="Horizontal">
                <!--StackPanel: It's a box-->

                <Button Content="打开"
                        Padding="12,4"
                        Margin="0,0,6,0"
                        Click="OnOpenClick"/>
                <!--Padding: inside; Margin: outside-->
                <!--Margin: Left Top Right Bottom-->

                <Button Content="保存"
                        Padding="12,4"
                        Margin="0,0,12,0"
                        Click="OnSaveClick"/>

                <TextBlock x:Name="FileNameText"
                           Text="未命名.txt"
                           VerticalAlignment="Center"
                           Foreground="#666666"/>

            </StackPanel>
        </Border>

        <Border Grid.Row="0"
                Grid.Column="2"
                Background="#F3F3F3"
                Padding="8,6">

            <StackPanel Orientation="Horizontal">

                <TextBlock x:Name="FilePathText"
                           Text="无"
                           VerticalAlignment="Center"
                           Foreground="#666666"/>

            </StackPanel>

        </Border>

        <!--Input Area-->
        <TextBox x:Name="EditorBox"
                 Grid.Row="1"
                 Grid.Column="2"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas"
                 FontSize="14"
                 Padding="8"
                 BorderThickness="0"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 SpellCheck.IsEnabled="False"/>

        <!--Splitter Line-->
        <GridSplitter Grid.Row="1"
                      Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#E0E0E0"/>

        <!--Chat Area-->
        <Grid Grid.Row="1"
              Grid.Column="0"
              ShowGridLines="False">

            <!--Row/Column Definition-->
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="ChatScrollViewer"
                          Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="8">

                <TextBlock x:Name="ChatContentText"
                           Text=""
                           TextWrapping="Wrap"
                           Foreground="#666666"/>

            </ScrollViewer>

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="InputBox"
                         Grid.Column="0"
                         AcceptsReturn="False"
                         AcceptsTab="True"
                         TextWrapping="wrap"
                         FontFamily="Consolas"
                         FontSize="14"
                         Padding="8"
                         BorderThickness="0"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="#F3F3F3"
                         SpellCheck.IsEnabled="False"/>

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="发送"
                        Padding="6,4"
                        Margin="3,3"
                        IsDefault="True"
                        Click="OnSendClick"/>

            </Grid>

        </Grid>

    </Grid>

</Window>